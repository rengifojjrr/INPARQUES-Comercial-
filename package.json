{
  "name": "inparques-comercial-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo navegable de INPARQUES Comercial: PWA visitante, portal comercio y panel institucional sobre una sola base de datos local.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "matriz": "node scripts/generar-matriz.mjs",
    "verificar": "node scripts/verificar-navegacion.mjs",
    "unico": "node scripts/construir-unico.mjs"
  },
  "devDependencies": {
    "playwright": "1.49.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
